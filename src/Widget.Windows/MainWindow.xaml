<Window x:Class="LimitsWidget.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Лимиты Codex" Width="340" SizeToContent="Height" MinWidth="340" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" WindowStyle="None" ResizeMode="NoResize" Background="Transparent" FontFamily="Segoe UI Variable, Segoe UI" Foreground="#F4F5F7" ShowInTaskbar="False">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#18FFFFFF"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,5"/><Setter Property="Foreground" Value="#F2F4F7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="PinStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="ToolTip" Value="Закрепить поверх окон"/>
   <Setter Property="AutomationProperties.HelpText" Value="Закрепление выключено"/>
   <Style.Triggers><DataTrigger Binding="{Binding Topmost, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True"><Setter Property="Background" Value="#805A9EE6"/><Setter Property="ToolTip" Value="Закреплено поверх окон"/><Setter Property="AutomationProperties.HelpText" Value="Закрепление включено"/></DataTrigger></Style.Triggers>
  </Style>
 </Window.Resources>
 <Border x:Name="GlassSurface" CornerRadius="8" BorderBrush="#22FFFFFF" BorderThickness="1">
  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2021262D" Offset="0"/><GradientStop Color="#50313741" Offset="1"/></LinearGradientBrush></Border.Background>
  <Grid><Border x:Name="NoiseLayer" CornerRadius="8" IsHitTestVisible="False"/><Grid Margin="22,17">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid MouseLeftButtonDown="DragHeader"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="QuotaTitle" Text="Codex" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" Grid.Column="1"><Button x:Name="PinButton" Style="{StaticResource PinStyle}" AutomationProperties.Name="Поверх окон" Click="ToggleTopmost" Margin="0,0,5,0"><Path Width="12" Height="14" Stretch="Uniform" Stroke="#E5E9EF" StrokeThickness="1.3" StrokeLineJoin="Round" Data="M 4,1 L 10,1 M 5,1 L 5,6 L 2,9 L 12,9 L 9,6 L 9,1 M 7,9 L 7,14"/></Button><Button Content="−" ToolTip="Скрыть в трей" Click="HideWindow"/></StackPanel></Grid>
   <ComboBox x:Name="Buckets" Grid.Row="1" Margin="0,9,0,4" DisplayMemberPath="DisplayName" SelectionChanged="BucketChanged" Visibility="Collapsed"/>
   <Grid Grid.Row="2" Margin="0,5,0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Grid Width="112" Height="112"><Ellipse Stroke="#28FFFFFF" StrokeThickness="8" Margin="6"/><Path x:Name="PrimaryArc" Stroke="#34C759" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><Grid Width="24" Height="24" Margin="0,0,0,6"><Ellipse Stroke="#F3F5F8" StrokeThickness="1.7" Margin="1"/><Path Stroke="#F3F5F8" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 12,6 L 12,12 L 17,15"/></Grid><TextBlock x:Name="PrimaryLabel" Text="5 ч" FontSize="17" FontWeight="Medium" HorizontalAlignment="Center"/></StackPanel></Grid><TextBlock x:Name="PrimaryValue" Text="—" FontSize="30" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,7,0,0"/><TextBlock Text="осталось" FontSize="10" Foreground="#B6BDC8" HorizontalAlignment="Center"/><TextBlock x:Name="PrimaryReset" Text="Нет данных" HorizontalAlignment="Center" Foreground="#B6BDC8" FontSize="10.5" TextAlignment="Center" LineHeight="14" Margin="0,7,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"><Grid Width="112" Height="112"><Ellipse Stroke="#28FFFFFF" StrokeThickness="8" Margin="6"/><Path x:Name="SecondaryArc" Stroke="#34C759" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><Path Width="23" Height="24" Stretch="Uniform" Stroke="#F3F5F8" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,0,6" Data="M 4,5 L 20,5 Q 22,5 22,7 L 22,21 Q 22,23 20,23 L 4,23 Q 2,23 2,21 L 2,7 Q 2,5 4,5 Z M 2,10 L 22,10 M 7,2 L 7,7 M 17,2 L 17,7 M 7,15 L 10,15 M 14,15 L 17,15 M 7,19 L 10,19"/><TextBlock x:Name="SecondaryLabel" Text="7 д" FontSize="17" FontWeight="Medium" HorizontalAlignment="Center"/></StackPanel></Grid><TextBlock x:Name="SecondaryValue" Text="—" FontSize="30" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,7,0,0"/><TextBlock Text="осталось" FontSize="10" Foreground="#B6BDC8" HorizontalAlignment="Center"/><TextBlock x:Name="SecondaryReset" Text="Нет данных" HorizontalAlignment="Center" Foreground="#B6BDC8" FontSize="10.5" TextAlignment="Center" LineHeight="14" Margin="0,7,0,0"/></StackPanel>
   </Grid>
   <TextBlock x:Name="Status" Grid.Row="3" Text="Подключение…" Margin="0,15,0,0" FontSize="10" Foreground="#B6BDC8" TextWrapping="Wrap"/>
  </Grid></Grid>
 </Border>
</Window>
